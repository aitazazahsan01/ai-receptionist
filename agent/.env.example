# From your LiveKit Cloud project settings (or your self-hosted server's config).
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# console.groq.com -> API Keys. Free tier, no card required.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# console.deepgram.com -> API Keys. $200 trial credit, no card required.
DEEPGRAM_API_KEY=

# elevenlabs.io -> Profile -> API Keys. Free tier: 10k characters/month.
ELEVENLABS_API_KEY=

# Backend's REST API, for tool calls (FAQ lookup, calendar booking, transfer).
BACKEND_URL=http://localhost:4000

# Must exactly match INTERNAL_TOOLS_SECRET in apps/backend/.env.
INTERNAL_TOOLS_SECRET=

# Must exactly match BUSINESS_TIMEZONE in apps/backend/.env -- used to tell the
# AI the current business-local date/time so it can resolve relative dates
# ("tomorrow", "Tuesday afternoon") for the check_availability/book_appointment
# tools (Phase 5).
BUSINESS_TIMEZONE=America/New_York
