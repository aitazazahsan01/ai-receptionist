generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CallOutcome {
  booked
  faq_answered
  transferred
  abandoned
  no_action
}

enum Speaker {
  caller
  agent
}

enum AppointmentStatus {
  confirmed
  cancelled
}

model Call {
  id             String       @id @default(uuid())
  twilioCallSid  String       @unique @map("twilio_call_sid")
  callerNumber   String       @map("caller_number")
  startedAt      DateTime     @map("started_at")
