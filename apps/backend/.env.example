PORT=4000
DATABASE_URL=postgresql://receptionist:receptionist@localhost:5432/ai_receptionist
REDIS_URL=redis://localhost:6379

# From the Twilio console (Account Info panel) once you've signed up (Phase 2).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# The publicly reachable URL Twilio can hit for webhooks -- an ngrok (or similar)
# tunnel URL in dev, e.g. https://abcd1234.ngrok-free.app. No trailing slash.
# Also used to verify Twilio's request signature, so it must exactly match the
# URL Twilio was configured to call.
PUBLIC_BASE_URL=

# LiveKit inbound SIP trunk details (see infra/livekit-sip/README.md). The
# username/password here must match what the trunk was created with -- Twilio
# authenticates to LiveKit's SIP endpoint using them.
LIVEKIT_SIP_HOST=
LIVEKIT_SIP_USERNAME=
LIVEKIT_SIP_PASSWORD=

# Shared secret the agent worker (agent/.env) sends as a Bearer token when
# calling /tools/*. Any long random string -- generate with, e.g.,
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
INTERNAL_TOOLS_SECRET=

# Google Calendar (Phase 5) -- service account auth against one shared business
# calendar, no per-user OAuth needed. See docs/03-FREE-TIER-STACK.md for setup:
# Google Cloud project -> enable Calendar API -> create a service account ->
# download its JSON key -> share the target calendar with the service account's
# email (Settings and sharing -> Share with specific people).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_CALENDAR_ID=

